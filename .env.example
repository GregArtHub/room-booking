# Скопируйте в .env:  cp .env.example .env
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=booking

# Секрет подписи JWT: сгенерируйте длинную случайную строку, например `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# Адрес, с которого открывается клиент (используется для CORS и ссылок восстановления пароля).
# Для публичного деплоя укажите свой домен, например https://booking.example.com
FRONTEND_URL=http://localhost:8080

# Порт клиента на хосте
WEB_PORT=8080

# true — при старте наполнить БД тестовыми данными (роли, комнаты, пользователи)
RUN_SEED=true
